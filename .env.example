# 같은 Origin 프록시를 사용하므로 비워둡니다.
VITE_API_BASE_URL=

# 로컬 개발 서버가 /api 요청을 전달할 Backend 주소입니다.
VITE_API_PROXY_TARGET=https://api.local-stamp.org

# 로컬 브라우저에서 presigned PUT을 같은 Origin으로 전달할 S3 버킷 Origin입니다.
# 운영 배포에서는 S3 버킷 CORS에 실제 프론트 Origin을 별도로 허용해야 합니다.
VITE_IMAGE_UPLOAD_PROXY_TARGET=https://regional-event-prod-images-682033466829.s3.ap-northeast-2.amazonaws.com

# PortOne V2 공개 식별자입니다. API Secret이나 Webhook Secret을 넣지 마세요.
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=

# 로컬 터널로 실제 웹훅을 받을 때만 설정합니다.
VITE_PORTONE_NOTICE_URL=
